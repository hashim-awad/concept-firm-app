# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project > Settings > Environment Variables.

# Supabase project URL, e.g. https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Safe for browsers; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...). Server only. Used only to create staff logins (invites).
SUPABASE_SECRET_KEY=
# The app's own address for invite and reset links, e.g. https://app.conceptaccounting.ca
# Optional on Vercel previews: the branch preview address is used when this is empty.
SITE_URL=

# Supabase Auth "Send Email" hook secret (v1,whsec_...). From Supabase > Authentication > Auth Hooks.
SEND_EMAIL_HOOK_SECRET=
# Microsoft 365 email (Microsoft Graph, OAuth). From the Entra app registration "Concept Firm App - email".
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# The mailbox the app sends from, e.g. app@conceptaccounting.ca (a shared mailbox is fine).
MAIL_FROM=

# Test app only (not Live): signing emails go only to these domains (comma separated). Default: conceptaccounting.ca
TEST_EMAIL_ALLOW=
